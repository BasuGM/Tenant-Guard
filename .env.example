# Database (migration / bootstrap role for M1)
DATABASE_URL=postgres://tenantguard:tenantguard@localhost:5432/tenantguard
# Runtime app role (M2+; no BYPASSRLS)
DATABASE_APP_URL=postgres://tenantguard_app:tenantguard_app@localhost:5432/tenantguard

# API / Web (defaults avoid common local 3000/3001 collisions)
API_PORT=3101
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3100
API_PUBLIC_URL=http://localhost:3100/api
API_ORIGIN=http://localhost:3101

# Redis (M5+)
REDIS_URL=redis://localhost:6379

# SQS / ElasticMQ (M6+)
SQS_ENDPOINT=http://localhost:9324
SQS_REGION=us-east-1
SQS_EXPORTS_QUEUE_URL=http://localhost:9324/queue/tenantguard-exports
SQS_EXPORTS_DLQ_URL=http://localhost:9324/queue/tenantguard-exports-dlq
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# S3 / local stand-in (adobe/s3mock on :9000)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tenantguard-exports
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# OIDC (M3+)
OIDC_ISSUER=http://localhost:3102
OIDC_CLIENT_ID=tenantguard-web
OIDC_CLIENT_SECRET=tenantguard-dev-secret
OIDC_REDIRECT_URI=http://localhost:3100/api/auth/callback
IDP_PORT=3102

# OpenTelemetry (M7+)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=tenantguard-api
